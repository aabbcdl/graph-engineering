{
  "name": "graph-engineering",
  "version": "0.3.0",
  "description": "A durable, evidence-driven multi-agent engineering graph for repository audit and repair.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "graph-engineering": "skills/autonomous-engineering-graph/scripts/graph-runner.mjs"
  },
  "scripts": {
    "test": "node --test skills/autonomous-engineering-graph/scripts/tests/*.test.mjs",
    "test:eval": "node --test evals/tests/*.test.mjs",
    "test:windows-write-smoke": "node scripts/windows-codex-write-smoke.mjs",
    "test:windows-codex-write-smoke": "node scripts/windows-codex-write-smoke.mjs --backend codex",
    "test:windows-claude-write-smoke": "node scripts/windows-codex-write-smoke.mjs --backend claude",
    "test:windows-claude-sandbox-smoke": "node scripts/windows-claude-readonly-smoke.mjs",
    "test:package-smoke": "node scripts/package-smoke.mjs",
    "eval:run": "node evals/run-paired.mjs",
    "eval:score": "node evals/score.mjs",
    "validate": "node skills/autonomous-engineering-graph/scripts/validate-specialist-pack.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "install:global": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "skills",
    "docs",
    "evals/adapters",
    "evals/fixtures",
    "evals/lib",
    "evals/tests",
    "evals/manifest.example.json",
    "evals/manifest.pilot.json",
    "evals/manifest.pilot-2500k.json",
    "evals/manifest.pilot-4000k.json",
    "evals/README.md",
    "evals/run-paired.mjs",
    "evals/score.mjs",
    "evals/scripts",
    "scripts/install.mjs",
    "scripts/package-smoke.mjs",
    "scripts/validate-package.mjs",
    "scripts/windows-codex-write-smoke.mjs",
    "scripts/windows-claude-readonly-smoke.mjs",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
