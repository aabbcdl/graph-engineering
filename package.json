{
  "name": "graph-engineering",
  "version": "0.2.0",
  "description": "A durable, evidence-driven multi-agent engineering graph for repository audit and repair.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "graph-engineering": "skills/autonomous-engineering-graph/scripts/graph-runner.mjs"
  },
