{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_summary",
    "mode",
    "scope",
    "risk_level",
    "completion_criteria",
    "required_checks",
    "discovery_skills",
    "review_nodes",
    "implementation_skills",
    "verification_skills",
    "excluded_surfaces"
  ],
  "properties": {
    "task_summary": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["task", "audit", "diagnosis", "review"] },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "completion_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "command", "evidence_tool", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": ["string", "null"] },
          "evidence_tool": { "type": ["string", "null"] },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "discovery_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_nodes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "focus", "skills"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "title": { "type": "string", "minLength": 1 },
          "focus": { "type": "string", "minLength": 1 },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 4
          }
        }
      }
    },
    "implementation_skills": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "verification_skills": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "excluded_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "reason"],
        "properties": {
          "surface": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
